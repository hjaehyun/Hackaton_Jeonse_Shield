{
  "name": "webapp",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/prepare-assets.mjs && vite build",
    "test": "node --test tests/*.test.js",
    "dev:sandbox": "wrangler pages dev dist --local --ip 0.0.0.0 --port 3000",
    "preview": "wrangler pages dev",
    "deploy": "gsk --no-input hosted deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings"
  },
  "dependencies": {
    "hono": "^4.13.8"
  },
  "devDependencies": {
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@playwright/test": "^1.63.0",
    "vite": "^8.1.4",
    "wrangler": "^4.110.0"
  }
}
